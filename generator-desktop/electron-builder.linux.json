{
  "appId": "jp.tsukuhako.desktop",
  "productName": "tsukuhako",
  "electronVersion": "44.9.1",
  "directories": {
    "app": "../dist/desktop-app",
    "output": "../dist/linux-deb"
  },
  "asar": false,
  "npmRebuild": false,
  "files": [
    "package.json"
  ],
  "publish": null,
  "linux": {
    "target": [
      {
        "target": "deb",
        "arch": [
          "x64"
        ]
      }
    ],
    "executableName": "tsukuhako",
    "icon": "public/brand-mark.png",
    "category": "Development",
    "maintainer": "garchomp-game <otoka.japanesedrum@gmail.com>",
    "vendor": "ツクハコ",
    "synopsis": "ツクハコ — 開発環境と学びの道具箱",
    "description": "開発環境を生成するツールと使い始めのガイド、教材を同梱しています。Linux Mint 22.3 x64向けの候補です。アプリ本体の導入とDocker等の開発準備は別の段階です。",
    "syncDesktopName": true,
    "desktop": {
      "entry": {
        "Name": "ツクハコ",
        "Comment": "開発環境を作り、同梱ガイドと教材で学ぶ",
        "Keywords": "ツクハコ;Tsukuhako;Development;Learning;",
        "Terminal": "false"
      }
    }
  },
  "deb": {
    "packageName": "tsukuhako",
    "artifactName": "tsukuhako-linux-amd64-${version}.deb",
    "priority": "optional",
    "compression": "xz",
    "depends": [
      "libgtk-3-0t64 | libgtk-3-0",
      "libnotify4",
      "libnss3",
      "libxss1",
      "libxtst6",
      "xdg-utils",
      "libatspi2.0-0t64 | libatspi2.0-0",
      "libuuid1",
      "libsecret-1-0",
      "libasound2t64 | libasound2",
      "libgbm1"
    ]
  },
  "extraResources": [
    {
      "from": "../dist/desktop-app",
      "to": "app",
      "filter": [
        "**/*",
        "!package.json"
      ]
    }
  ]
}
