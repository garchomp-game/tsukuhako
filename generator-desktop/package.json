{
  "name": "tsukuhako-desktop",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "main": "main.mjs",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "stage": "node ../tools/stage-desktop.mjs",
    "package:windows": "electron-builder --config electron-builder.json --win nsis --x64 --publish never",
    "test:package": "node --test tests/packaging.check.mjs",
    "package:linux": "electron-builder --config electron-builder.linux.json --linux deb --x64 --publish never",
    "curriculum": "node ../tools/build-curriculum.mjs"
  },
  "dependencies": {
    "markdown-it": "15.0.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.1",
    "electron-builder": "26.15.3",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  },
  "productName": "ツクハコ",
  "desktopName": "tsukuhako.desktop",
  "homepage": "https://github.com/garchomp-game/tsukuhako",
  "license": "MIT"
}
