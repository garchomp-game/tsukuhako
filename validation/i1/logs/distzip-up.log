services:
  app:
    environment:
      OTOKA_PROJECT_NAME: otoka-i1-2114039080
      PGCONNECT_TIMEOUT: "5"
      PGDATABASE: otoka_learning
      PGHOST: db
      PGPASSWORD: [REDACTED_LOCAL_PASSWORD]
      PGPORT: "5432"
      PGUSER: otoka
    image: otoka-i1-2114039080-dev:0.1.0
    init: true
    networks:
      default: null
    pull_policy: never
    tmpfs:
      - /var/lib/postgresql
    volumes:
      - type: bind
        source: [work-root]/validation/i1/runs/配布ZIP
          最終/I1
        target: /workspace
    depends_on:
      db:
        condition: service_healthy
        required: true
  db:
    environment:
      POSTGRES_DB: otoka_learning
      POSTGRES_INITDB_ARGS: --auth-host=scram-sha-256
      POSTGRES_PASSWORD: [REDACTED_LOCAL_PASSWORD]
      POSTGRES_USER: otoka
    image: postgres:18.6-bookworm@sha256:afc7e2d441324c0388fa80c3d24f733b4194a4eb7f47dd8ee2b08eb1a24a647c
    labels:
      otoka.template: I1
    networks:
      default: null
    shm_size: "134217728"
    volumes:
      - type: volume
        source: pgdata
        target: /var/lib/postgresql
        volume: {}
    healthcheck:
      test:
        - CMD-SHELL
        - pg_isready -U otoka -d otoka_learning
      timeout: 5s
      interval: 2s
      retries: 30
      start_period: 10s
