[2026-10-20T02:18:16.135Z] name: otoka-i1-validation-598241935
services:
  app:
    environment:
      OTOKA_PROJECT_NAME: otoka-i1-validation-598241935
      PGCONNECT_TIMEOUT: "5"
      PGDATABASE: otoka_learning
      PGHOST: db
      PGPASSWORD: [REDACTED_LOCAL_PASSWORD]
      PGPORT: "5432"
      PGUSER: otoka
    init: true
    networks:
      default: null
    tmpfs:
      - /var/lib/postgresql
    volumes:
      - type: bind
        source: [work-root]/validation/i1/runs/初回
          PostgreSQL
        target: /workspace
    build:
      context: [work-root]/validation/i1/runs/初回
        PostgreSQL
      dockerfile: .devcontainer/Dockerfile
    depends_on:
      db:
        condition: service_healthy
        required: true
  db:
    environment:
      POSTGRES_DB: otoka_learning
      POSTGRES_INITDB_ARGS: --auth-host=scram-sha-256
      POSTGRES_PASSWORD: [REDACTED_LOCAL_PASSWORD]
      POSTGRES_USER: otoka
    image: postgres:18.6-bookworm@sha256:afc7e2d441324c0388fa80c3d24f733b4194a4eb7f47dd8ee2b08eb1a24a647c
    labels:
      otoka.template: I1
    networks:
      default: null
    shm_size: "134217728"
    volumes:
      - type: volume
        source: pgdata
        target: /var/lib/postgresql
        volume: {}
    healthcheck:
      test:
        - CMD-SHELL
        - pg_isready -U otoka -d otoka_learning
      timeout: 5s
      interval: 2s
      retries: 30
      start_period: 10s
    ports:
      - mode: ingress
        host_ip: 127.0.0.1
        target: 5432
        published: "55432"
        protocol: tcp
networks:
  default:
    name: otoka-i1-validation-598241935_default
volumes:
  pgdata:
    name: otoka-i1-validation-598241935_pgdata
    labels:
      otoka.purpose: learning-database
      otoka.template: I1
