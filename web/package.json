{
  "name": "tsukuhako-mail-preview",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "content": "node scripts/import-content.mjs",
    "types": "wrangler types --include-runtime=false",
    "db:local": "wrangler d1 migrations apply DB --local",
    "dev": "node scripts/dev.mjs",
    "build": "npm run content && tsc --noEmit && vite build && node scripts/check-build.mjs",
    "test": "npm run content && tsx --test tests/*.test.ts",
    "check:release": "npm run content && node scripts/release-check.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261022.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "miniflare": "^5.20261019.1-beta",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "wrangler": "^4.151.3"
  }
}
